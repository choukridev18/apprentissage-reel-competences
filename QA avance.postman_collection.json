                  "})",
                  "",
                  "",
                  "pm.test(\"url est correct\",function(){",
                  "    const response = pm.response.json()",
                  "    const salle = pm.collectionVariables.get(\"salle\")",
                  "    pm.expect(response.url).to.eql(\"https://postman-echo.com/get?salle=\" +salle)",
                  "})",
                  "",
                  "pm.test(\"salle vaut A101 dans args\", function () {",
                  "    const reponse = pm.response.json()",
                  "    const salle = pm.collectionVariables.get(\"salle\")",
                  "    pm.expect(reponse.args.salle).to.eql(salle)",
                  "})"
